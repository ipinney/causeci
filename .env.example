# Copy to .env.local. Never commit real values.

# Optional public origin (defaults to http://localhost:3000 or VERCEL_URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — if any of these are missing, DEV_MODE mock unlock is enabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Supabase — if missing, jobs live in process memory (lost on restart)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional HTTP inference. If unset, a deterministic stub autopsy is used.
CAUSECI_INFER_URL=
